        reactants = Mixture(all_thermo, ['Air            ', 'C7H8(L)        ', 'C8H18(L),n-octa'])
        products = Mixture(all_thermo, [character(15) :: &
            '(HCOOH)2',        'Ar',              'C',               'C2',              'CH', &
            'CN',              'CO',              'CO2',             'H',               'H2', &
            'N',               'N2',              'NH',              'NO',              'O',  &
            'O2',              'OH',              'C10H8,naphthale', 'C2H',             'C2H2,acetylene', &
            'C2H2,vinylidene', 'C2H3,vinyl',      'C2H4',            'C2H4O,ethylen-o', 'C2H5', &
            'C2H5OH',          'C2H6',            'C3H3,1-propynl',  'C3H3,2-propynl',  'C3H6O,acetone', &
            'C3H6O,propanal',  'C3H6O,propylox',  'C4H2,butadiyne',  'C4H6,1butyne',    'C4H6,2butyne', &
            'C6H14,n-hexane',  'C7H16,2-methylh', 'CH2',             'CH2CO,ketene',    'CH2OH', &
            'CH3',             'CH3CHO,ethanal',  'CH3CN',           'CH3CO,acetyl',    'CH3COOH', &
            'CH3N2CH3',        'CH3O',            'CH3O2CH3',        'CH3OCH3',         'CH3OH', &
            'CH3OOH',          'CH4',             'CNCOCN',          'CNN',             'COOH', &
            'H2O',             'H2O2',            'HCCN',            'HCCO',            'HCHO,formaldehy', &
            'HCN',             'HCO',             'HCOOH',           'HNC',             'HNCO', &
            'HNO',             'HNO2',            'HNO3',            'HO(CO)2OH',       'HO2', &
            'N2H2',            'N2H4',            'N2O',             'N2O3',            'N2O4', &
            'N2O5',            'N3',              'N3H',             'NCN',             'NCO', &
            'NH2',             'NH2NO2',          'NH2OH',           'NH3',             'NO2', &
            'NO3',             'O(CH)2O',         'O3',              'OCCN',            'OHCH2COOH', &
            'C(gr)',           'H2O(cr)'  &
        ])

        solver = EqSolver(products, reactants, 1d-15, smooth_truncation=.true.)
        solution = EqSolution(solver)

        weights = reactants%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.4d0, 0.6d0], 17.0d0)
        v_reac = 1.0d0/14.428d0
        u_reac = -45.1343d0

        call solver%solve(solution, 'uv', u_reac, v_reac, weights)
        idx_species = find_smooth_target_species(solver, solution)
        idx_w0 = find_target_w0(solution)
        call assert_smooth_targeted_fd(solver, solution, idx_species, idx_w0, h, tol_species, tol_scalar, closure_tol)
    end subroutine

    @test
    subroutine test_sv_smooth_targeted_derivatives_fd
        type(Mixture) :: reactants, products
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        real(dp) :: weights(2), of_ratio, s_reac, v_reac
        integer :: idx_species, idx_w0
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol_species = 6.0d-2
        real(dp), parameter :: tol_scalar = 2.0d-1
        real(dp), parameter :: closure_tol = 1.0d-9

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")
        s_reac = reactants%calc_entropy(weights, 3000.0d0, 1.01325d0)/R

        call solver%solve(solution, 'sv', s_reac, v_reac, weights)
        idx_species = find_smooth_target_species(solver, solution)
        idx_w0 = find_target_w0(solution)
        call assert_smooth_targeted_fd(solver, solution, idx_species, idx_w0, h, tol_species, tol_scalar, closure_tol, &
                                       check_cp_fr=.false.)
    end subroutine

    @test
    subroutine test_smooth_post_process_entropy_uses_reported_nj
        type(Mixture) :: reac, prod
        type(EqSolver) :: solver
        type(EqSolution) :: soln, soln_plus, soln_minus
        type(EqDerivatives) :: totals
        real(dp) :: weights(2), fuel_weights(2), oxidizer_weights(2), of_ratio
        real(dp) :: temperature, pressure, h_pressure
        real(dp) :: entropy_sum
        real(dp) :: entropy_fd
        real(dp) :: log_p_over_n
        real(dp) :: rel
        integer :: i
        real(dp), parameter :: entropy_tol = 1.0d-10
        real(dp), parameter :: deriv_tol = 1.0d-2

        reac = Mixture(all_thermo, ['H2 ', 'Air'])
        prod = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(prod, reac, smooth_truncation=.true.)
        soln = EqSolution(solver)
        soln_plus = EqSolution(solver)
        soln_minus = EqSolution(solver)

        temperature = 1200.0d0
        pressure = 1.01325d0
        h_pressure = pressure*1.0d-4

        fuel_weights = reac%weights_from_moles([1.0d0, 0.0d0])
        oxidizer_weights = reac%weights_from_moles([0.0d0, 1.0d0])
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reac%weights_from_of(oxidizer_weights, fuel_weights, of_ratio)

        call solver%solve(soln, 'tp', temperature, pressure, weights)
        call solver%solve(soln_plus, 'tp', temperature, pressure + h_pressure, weights)
        call solver%solve(soln_minus, 'tp', temperature, pressure - h_pressure, weights)

        @assertTrue(soln%converged)

        entropy_sum = 0.0d0
        log_p_over_n = log(soln%calc_pressure()/soln%n)
        do i = 1, solver%num_gas
            if (soln%ln_nj(i) > solver%log_min) then
                entropy_sum = entropy_sum + soln%nj(i) * (soln%thermo%entropy(i) - soln%ln_nj(i) - log_p_over_n)
            else
                @assertEqual(0.0d0, soln%nj(i))
            end if
        end do
        if (solver%num_condensed > 0) then
            entropy_sum = entropy_sum + dot_product(soln%nj(solver%num_gas+1:), &
                                                    soln%thermo%entropy(solver%num_gas+1:))
        end if
        entropy_sum = entropy_sum * R / 1.0d3
        @assertRelativelyEqual(entropy_sum, soln%entropy, entropy_tol)

        totals = EqDerivatives(solver, soln)
        call totals%compute_derivatives(solver, soln)
        call totals%unpack_values(solver, soln)
        entropy_fd = (soln_plus%entropy - soln_minus%entropy) / (2.0d0*h_pressure)
        rel = abs(entropy_fd - totals%dS_dstate2) / max(max(abs(entropy_fd), abs(totals%dS_dstate2)), 1.0d-30)
        @assertLessThan(rel, deriv_tol)
    end subroutine

    @test
    subroutine test_example2_smooth_truncation
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(Mixture) :: reac, prod
        real(dp) :: v_reac, weights(2), of_ratio
        real(dp), parameter :: tol = 1.0d-6

        reac = Mixture(all_thermo, ['H2 ', 'Air'])
        prod = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(prod, reac, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the oxidant to fuel ratio
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reac%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")
        call solver%solve(solution, 'tv', 3000.0d0, v_reac, weights)

        ! Check the solution
        @assertTrue(solution%converged)
        @assertRelativelyEqual(3.1415977104767677d-4, solution%nj(1), tol)
        call assert_element_relative_convergence(solver, solution)
        @assertRelativelyEqual(7.5550321217326543d-6, solution%nj(3), tol)
        @assertRelativelyEqual(3.1461923264601023d-6, solution%nj(4), tol)

    end subroutine

    @test
    subroutine test_example3_smooth_truncation
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(Mixture) :: reac, prod
        real(dp) :: h_reac, p_reac, weights(3)
        real(dp), parameter :: tol = 1.0d-6

        reac = Mixture(all_thermo, ['Air            ', 'C7H8(L)        ', 'C8H18(L),n-octa'])
        prod = Mixture(all_thermo, [character(15) :: &
            '(HCOOH)2',        'Ar',              'C',               'C2',              'CH', &
            'CN',              'CO',              'CO2',             'H',               'H2', &
            'N',               'N2',              'NH',              'NO',              'O',  &
            'O2',              'OH',              'C10H8,naphthale', 'C2H',             'C2H2,acetylene', &
            'C2H2,vinylidene', 'C2H3,vinyl',      'C2H4',            'C2H4O,ethylen-o', 'C2H5', &
            'C2H5OH',          'C2H6',            'C3H3,1-propynl',  'C3H3,2-propynl',  'C3H6O,acetone', &
            'C3H6O,propanal',  'C3H6O,propylox',  'C4H2,butadiyne',  'C4H6,1butyne',    'C4H6,2butyne', &
            'C6H14,n-hexane',  'C7H16,2-methylh', 'CH2',             'CH2CO,ketene',    'CH2OH', &
            'CH3',             'CH3CHO,ethanal',  'CH3CN',           'CH3CO,acetyl',    'CH3COOH', &
            'CH3N2CH3',        'CH3O',            'CH3O2CH3',        'CH3OCH3',         'CH3OH', &
            'CH3OOH',          'CH4',             'CNCOCN',          'CNN',             'COOH', &
            'H2O',             'H2O2',            'HCCN',            'HCCO',            'HCHO,formaldehy', &
            'HCN',             'HCO',             'HCOOH',           'HNC',             'HNCO', &
            'HNO',             'HNO2',            'HNO3',            'HO(CO)2OH',       'HO2', &
            'N2H2',            'N2H4',            'N2O',             'N2O3',            'N2O4', &
            'N2O5',            'N3',              'N3H',             'NCN',             'NCO', &
            'NH2',             'NH2NO2',          'NH2OH',           'NH3',             'NO2', &
            'NO3',             'O(CH)2O',         'O3',              'OCCN',            'OHCH2COOH', &
            'C(gr)',           'H2O(cr)'  &
        ])

        solver = EqSolver(prod, reac, 1d-15, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the reactant weights
        weights = reac%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.4d0, 0.6d0], 17.0d0)

        ! Get the constraint values
        h_reac = reac%calc_enthalpy(weights, [700.0d0, 298.15d0, 298.15d0])/R
        p_reac = 100.0d0

        ! Test the full solve
        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        @assertTrue(solution%converged)
        @assertRelativelyEqual(2418.6600226586033d0, solution%T, tol)
        @assertRelativelyEqual(3.0535773627690590d-4, solution%nj(2), tol)
        @assertRelativelyEqual(5.7795659563264964d-5, solution%nj(7), tol)
        @assertRelativelyEqual(3.9753864316861218d-3, solution%nj(8), tol)
        @assertRelativelyEqual(3.5412635901275881d-3, solution%nj(56), tol)
        @assertRelativelyEqual(2.5342964740943361d-2, solution%nj(12), tol)

    end subroutine

