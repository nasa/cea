    @test
    subroutine test_partials

        type(Mixture) :: reac, prod
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqPartials) :: partials
        real(dp) :: weights(2), of_ratio, b_reac(5)
        real(dp), parameter :: tol = 1.0d-6

        reac = Mixture(all_thermo, ['H2 ', 'Air'])
        prod = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(prod, reac)
        solution = EqSolution(solver)

        ! Get the oxidant to fuel ratio
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        @assertRelativelyEqual(34.296226d0, of_ratio, tol)
        weights = reac%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        b_reac = reac%element_amounts_from_weights(weights)
        solution%constraints = EqConstraints('tp', 3000.0d0, 1.01325d0, b_reac)

        ! Fix the temperature and update the thermo properties
        solution%T = 3000.0d0
        call solver%products%calc_thermo(solution%thermo, solution%T)

        call solver%solve(solution, 'tp', 3000.0d0, 1.01325d0, weights, partials)

        @assertRelativelyEqual( 1.6957400222123469d0, partials%dlnV_dlnT, tol)
        @assertRelativelyEqual(-1.0344181562262706d0, partials%dlnV_dlnP, tol)

        @assertRelativelyEqual(0.84623025774613159d0, partials%cp_eq, tol)
        @assertRelativelyEqual(1.1311926485772785d0, partials%gamma_s, tol)

    end subroutine

    @test
    subroutine test_ionized

        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: soln
        character(snl), allocatable :: product_names(:)
        real(dp) :: p_reac, t_reac, weights(1)
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Air'], ions=.true.)
        product_names = reactants%get_products(all_thermo, omit=["C(gr)"])
        products = Mixture(all_thermo, product_names, ions=.true.)

        solver = EqSolver(products, reactants, ions=.true.)
        soln = EqSolution(solver)

        weights = [1.0d0]
        t_reac = 5000.0d0
        p_reac = 0.0101325d0

        call solver%solve(soln, 'tp', t_reac, p_reac, weights)

        ! Testing products (in order): e-, Ar, Ar+, C, C+, C-, CO, CO+, CO2, CO2+, N, N+, N-, N2, N2+, N2-, O2, O2+, O2-
        @assertRelativelyEqual(-12.070356495712987d0, soln%ln_nj(55), tol)
        @assertRelativelyEqual(-8.0368688126426946d0, soln%ln_nj(1), tol)
        @assertRelativelyEqual(-22.264240029189903d0, soln%ln_nj(2), tol)
        @assertRelativelyEqual(-14.838922358373637d0, soln%ln_nj(3), tol)
        @assertRelativelyEqual(-20.735101993506479d0, soln%ln_nj(4), tol)
        @assertRelativelyEqual(-32.500783362184301d0, soln%ln_nj(5), tol)
        @assertRelativelyEqual(-11.451439526036818d0, soln%ln_nj(23), tol)
        @assertRelativelyEqual(-22.632392242196225d0, soln%ln_nj(24), tol)
        @assertRelativelyEqual(-22.377017680700916d0, soln%ln_nj(25), tol)
        @assertRelativelyEqual(-31.407105066987096d0, soln%ln_nj(26), tol)
        @assertRelativelyEqual(-4.5563479759981425d0, soln%ln_nj(27), tol)
        @assertRelativelyEqual(-16.829742821831005d0, soln%ln_nj(28), tol)
        @assertRelativelyEqual(-24.603443181224556d0, soln%ln_nj(29), tol)
        @assertRelativelyEqual(-3.8318205191336161d0, soln%ln_nj(30), tol)
        @assertRelativelyEqual(-18.361166746337737d0, soln%ln_nj(31), tol)
        @assertRelativelyEqual(-26.501061644411305d0, soln%ln_nj(32), tol)
        @assertRelativelyEqual(-13.906923284689297d0, soln%ln_nj(50), tol)
        @assertRelativelyEqual(-21.381854649368115d0, soln%ln_nj(51), tol)
        @assertRelativelyEqual(-32.784807259253490d0, soln%ln_nj(52), tol)

    end subroutine

    @test
    subroutine test_high_temperature_ionized_ar_n2_h2

        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: soln
        character(snl), allocatable :: product_names(:)
        integer :: idx_ar_plus, idx_h_plus, idx_n_plus, idx_electron
        real(dp) :: pressure, weights(3)
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Ar', 'N2', 'H2'], ions=.true.)
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names, ions=.true.)

        solver = EqSolver(products, reactants, ions=.true.)
        soln = EqSolution(solver)

        weights = reactants%weights_from_moles([0.75d0, 0.10d0, 0.15d0])
        pressure = atm_to_bar(1.0d0)

        call solver%solve(soln, 'tp', 20000.0d0, pressure, weights)

        idx_ar_plus = findloc(products%species_names, 'Ar+', dim=1)
        idx_h_plus = findloc(products%species_names, 'H+', dim=1)
        idx_n_plus = findloc(products%species_names, 'N+', dim=1)
        idx_electron = findloc(products%species_names, 'e-', dim=1)

        @assertTrue(soln%converged)
        @assertRelativelyEqual(20000.0d0, soln%T, tol)
        @assertRelativelyEqual(7.426681957390653d-2, soln%n, tol)

        ! Major ionized-species mole fractions agree with the CEA2 high-temperature reference case.
        @assertRelativelyEqual(2.9875203384714055d-1, soln%nj(idx_ar_plus)/soln%n, tol)
        @assertRelativelyEqual(1.1399947689736623d-1, soln%nj(idx_h_plus)/soln%n, tol)
        @assertRelativelyEqual(7.8210494984876172d-2, soln%nj(idx_n_plus)/soln%n, tol)
        @assertRelativelyEqual(4.9096191012797125d-1, soln%nj(idx_electron)/soln%n, tol)

    end subroutine

    @test
    subroutine test_negative_reactant
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        character(snl), allocatable :: product_names(:)
        real(dp) :: t_reac, p_reac, weights(3)
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Air   ', 'H2O   ', 'H2O(L)'])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        weights = [0.9069637d0, 0.1813927d0, -0.0883564d0]
        t_reac = 555.56d0
        p_reac = convert_units_to_si(68.046d0, "atm")

        call solver%solve(solution, 'tp', t_reac, p_reac, weights)

        ! ! Products: Ar, CO2, H2O, N2, O2
        ! write(*,*) "NEGATIVE REACTANTS"
        ! write(*,*) "n = ", solution%n, abs((1.0d0/27.415d0)-solution%n)/(1.0d0/27.415d0)
        ! write(*,*) "Ar = ", solution%nj(3), abs(2.9323946327273809d-4-solution%nj(3))/2.9323946327273809d-4
        ! write(*,*) "CO2 = ", solution%nj(114), abs(9.9891136342931817d-6-solution%nj(114))/9.9891136342931817d-6
        ! write(*,*) "H2O = ", solution%nj(118), abs(5.1642986488878171d-3-solution%nj(118))/5.1642986488878171d-3
        ! write(*,*) "N2 = ", solution%nj(134), abs(2.4449868424820789d-2-solution%nj(134))/2.4449868424820789d-2
        ! write(*,*) "O2 = ", solution%nj(155), abs(6.5591518211682090d-3-solution%nj(155))/6.5591518211682090d-3

        @assertRelativelyEqual(1.0d0/27.415d0, solution%n, 1.d-5)
        @assertRelativelyEqual(2.9323946327273809d-4,   solution%nj(3), tol)
        call assert_element_relative_convergence(solver, solution)
        @assertRelativelyEqual(9.9886160185893425d-6, solution%nj(114), tol)
        @assertRelativelyEqual(5.1642986488878171d-3, solution%nj(118), tol)
        @assertRelativelyEqual(2.4449868424820789d-2, solution%nj(134), tol)
        @assertRelativelyEqual(6.5591518211682090d-3, solution%nj(155), tol)

    end subroutine

    @test
    subroutine test_equilibrium_transport_ch4_o2
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        character(:), allocatable :: product_names(:)
        real(dp) :: h_reac, p_reac, weights(2)

        reactants = Mixture(all_thermo, ['CH4', 'O2 '])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants, all_transport=all_transport)
        solution = EqSolution(solver)

        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 2.6d0)
        h_reac = reactants%calc_enthalpy(weights, [298.15d0, 298.15d0])/R
        p_reac = psi_to_bar(1000.0d0)

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        @assertTrue(solution%converged)
        @assertTrue(solution%viscosity > 0.0d0)
        @assertTrue(solution%conductivity_fr > 0.0d0)
        @assertTrue(solution%conductivity_eq > 0.0d0)
        @assertTrue(solution%pr_fr > 0.0d0)
        @assertTrue(solution%pr_eq > 0.0d0)
    end subroutine

    @test
    subroutine test_inert_reactant
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        character(snl), allocatable :: product_names(:)
        real(dp) :: t_reac, p_reac, weights(3)
        real(dp), parameter :: tol = 1.0d-3

        ! NOTE: set thermo to thermo-inert.lib before running this test

        reactants = Mixture(all_thermo, ['Air      ', 'JP-4     ', 'InertJP-4'])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        weights = [0.95d0, 0.025d0, 0.025d0]
        t_reac = 555.56d0
        p_reac = convert_units_to_si(68.046d0, "atm")

        call solver%solve(solution, 'tp', t_reac, p_reac, weights)

        ! Products: Ar, CO2, H2O, InertCH4, InertC10H8, N2, O2
        @assertRelativelyEqual(1.0d0/29.053d0, solution%n, tol)
        @assertRelativelyEqual(-8.0881614446139025, solution%ln_nj(3), tol)
        @assertRelativelyEqual(-6.3196848293817531, solution%ln_nj(114), tol)
        @assertRelativelyEqual(-6.3559720462738909, solution%ln_nj(118), tol)
        @assertRelativelyEqual(-7.3579377957440624, solution%ln_nj(135), tol)
        @assertRelativelyEqual(-9.0683751932082703, solution%ln_nj(133), tol)
        @assertRelativelyEqual(-14.990974766155743, solution%ln_nj(137), tol)
        @assertRelativelyEqual(-3.6647707468791499, solution%ln_nj(139), tol)
        @assertRelativelyEqual(-5.4697759938827026, solution%ln_nj(160), tol)

    end subroutine

    @test
    subroutine test_hp_derivatives
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: h_reac, p_reac, weights(2)
        real(dp), parameter :: tol = 1.0d-6
        integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        h_reac = reactants%calc_enthalpy(weights, 2000.0d0)/R
        p_reac = 1.01325d0

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution, check_closure_defect=.true.)

        do i = 1, totals%m
            @assertLessThan(maxval(abs(totals%delta_check(:, i))), tol)
        end do

    end subroutine

    subroutine assert_hp_air_pressure_derivative(weights, temperature, pressure, species)
        real(dp), intent(in) :: weights(2), temperature, pressure
        character(*), intent(in) :: species
        type(Mixture) :: reactants, products
        type(EqSolver) :: solver
        type(EqSolution) :: solution, plus, minus
        type(EqDerivatives) :: totals
        real(dp) :: h_reac, step, analytic, numerical
        real(dp) :: nj_eff, carbon, carbon0
        real(dp), parameter :: steps(3) = [1.0d-3, 1.0d-4, 1.0d-5]
        integer :: i, k, idx_species, idx_c

        ! State 2 from the H2/database-Air independent-input probe, seed 20260827.
        ! The old max(b0)-scaled element tolerance accepted a carbon residual
        ! near 1.74e-9 and a CO2 log-pressure FD slope 25% below the analytic one.
        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, reactant_names=['H2 ', 'Air'])
        solver = EqSolver(products, reactants)
        h_reac = reactants%calc_enthalpy(weights, temperature)/R
        idx_species = findloc(products%species_names, species, 1)
        idx_c = findloc(products%element_names, 'C', 1)
        solution = EqSolution(solver)
        call solver%solve(solution, 'hp', h_reac, pressure, weights)
        @assertTrue(solution%converged)
        @assertGreaterThan(solution%nj(idx_species)/solution%n, 1.0d-4)

        ! Test the inventory used by the nonlinear residual, not final reporting
        ! (which also exposes amounts below the solve-path activity threshold).
        carbon = 0.0d0
        do i = 1, solver%num_gas
            call compute_nj_effective(solution%ln_nj(i), log(solution%n)-solution%converged_tsize, &
                                      .false., solver%truncation_width, nj_eff)
            carbon = carbon + nj_eff*products%stoich_matrix(i, idx_c)
        end do
        carbon0 = solution%constraints%b0(idx_c)
        @assertLessThan(abs(carbon-carbon0)/carbon0, 1.0d-6)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        analytic = totals%dnj_dstate2(idx_species)*pressure*log(30.0d0)
        do k = 1, size(steps)
            step = steps(k)
            plus = EqSolution(solver)
            minus = EqSolution(solver)
            call solver%solve(plus, 'hp', h_reac, pressure*exp(log(30.0d0)*step), weights)
            call solver%solve(minus, 'hp', h_reac, pressure*exp(-log(30.0d0)*step), weights)
            @assertTrue(plus%converged)
            @assertTrue(minus%converged)
            numerical = (plus%nj(idx_species)-minus%nj(idx_species))/(2.0d0*step)
            @assertLessThan(relative_error(analytic, numerical), 1.0d-3)
        end do
    end subroutine

    @test
    subroutine test_hp_database_air_minor_element_pressure_derivative
        call assert_hp_air_pressure_derivative([0.021289451195033934d0, 0.97871054880496611d0], &
                                               661.5455168487204d0, 7.242735337192802d0, 'CO2')
        ! State 201 has a small CO pressure slope: a row-scaled error metric
        ! masks a componentwise error even after tightening balance residuals.
        call assert_hp_air_pressure_derivative([0.036477263400782799d0, 0.96352273659921728d0], &
                                               740.6753399520376d0, 6.642358333801742d0, 'CO')
    end subroutine

    @test
    subroutine test_hp_derivatives_fd
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: h_reac, p_reac, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        ! integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        h_reac = reactants%calc_enthalpy(weights, 2000.0d0)/R
        p_reac = 1.01325d0

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_constrained_enthalpy_output_row(totals, 1.0d-4, 1.0d-3)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / &
              max(max(abs(totals%dH_dstate1_fd), abs(totals%dH_dstate1)), 1.0d-8)
        ! write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / &
              max(max(abs(totals%dH_dstate2_fd), abs(totals%dH_dstate2)), 1.0d-8)
        ! write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / &
                     max(max(abs(totals%dH_dw0_fd), abs(totals%dH_dw0)), 1.0d-8))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        ! write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        ! write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        ! write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        ! write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / &
              max(max(abs(totals%dS_dstate1_fd), abs(totals%dS_dstate1)), 1.0d-8)
        ! write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / &
              max(max(abs(totals%dS_dstate2_fd), abs(totals%dS_dstate2)), 1.0d-8)
        ! write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / &
                     max(max(abs(totals%dS_dw0_fd), abs(totals%dS_dw0)), 1.0d-8))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)
    end subroutine



    @test
    subroutine test_hp_derivatives_fd_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: h_reac, p_reac, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        h_reac = reactants%calc_enthalpy(weights, 2000.0d0)/R
        p_reac = 1.01325d0

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_constrained_enthalpy_output_row(totals, 1.0d-4, 1.0d-3)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / &
              max(max(abs(totals%dH_dstate1_fd), abs(totals%dH_dstate1)), 1.0d-8)
        write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / &
              max(max(abs(totals%dH_dstate2_fd), abs(totals%dH_dstate2)), 1.0d-8)
        write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / &
                     max(max(abs(totals%dH_dw0_fd), abs(totals%dH_dw0)), 1.0d-8))
        do i = 1, solver%num_reactants
            write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / &
              max(max(abs(totals%dS_dstate1_fd), abs(totals%dS_dstate1)), 1.0d-8)
        write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / &
              max(max(abs(totals%dS_dstate2_fd), abs(totals%dS_dstate2)), 1.0d-8)
        write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / &
                     max(max(abs(totals%dS_dw0_fd), abs(totals%dS_dw0)), 1.0d-8))
        do i = 1, solver%num_reactants
            write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        if (abs(totals%dT_dstate1) > 1.0d-12 .and. abs(totals%dT_dstate1_fd) > 1.0d-12) then
            write(*,*) "dH/dT: an=", totals%dH_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dH_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd - totals%dH_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dH_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dU/dT: an=", totals%dU_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dU_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd - totals%dU_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dU_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dG/dT: an=", totals%dG_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dG_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd - totals%dG_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dG_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dS/dT: an=", totals%dS_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dS_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd - totals%dS_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dS_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dCp_fr/dT: an=", totals%dCp_fr_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd - totals%dCp_fr_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dCp_fr_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
        end if

    end subroutine

    @test
    subroutine test_tp_derivatives
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: p_reac, weights(2)
        real(dp), parameter :: tol = 1.0d-6
        integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        p_reac = 1.01325d0

        call solver%solve(solution, 'tp', 3200.0d0, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution, check_closure_defect=.true.)

        do i = 1, totals%m
            @assertLessThan(maxval(abs(totals%delta_check(:, i))), tol)
        end do

    end subroutine


    @test
    subroutine test_tp_derivatives_fd
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: p_reac, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 5.0d-2
        real(dp) :: rel
        ! integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        p_reac = 1.01325d0

        call solver%solve(solution, 'tp', 3200.0d0, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_fixed_temperature_output_row(totals)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        ! write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        ! write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        ! write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        ! write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        ! write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        ! write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        ! write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        ! write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)
    end subroutine




    @test
    subroutine test_tp_derivatives_fd_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: p_reac, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 5.0d-2
        real(dp) :: rel
        integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        p_reac = 1.01325d0

        call solver%solve(solution, 'tp', 3200.0d0, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_fixed_temperature_output_row(totals)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        if (abs(totals%dT_dstate1) > 1.0d-12 .and. abs(totals%dT_dstate1_fd) > 1.0d-12) then
            write(*,*) "dH/dT: an=", totals%dH_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dH_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd - totals%dH_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dH_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dU/dT: an=", totals%dU_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dU_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd - totals%dU_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dU_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dG/dT: an=", totals%dG_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dG_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd - totals%dG_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dG_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dS/dT: an=", totals%dS_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dS_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd - totals%dS_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dS_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dCp_fr/dT: an=", totals%dCp_fr_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd - totals%dCp_fr_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dCp_fr_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
        end if

    end subroutine

    @test
    subroutine test_sp_derivatives
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: s_reac, p_reac, weights(2)
        real(dp), parameter :: tol = 1.0d-6
        integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        p_reac = 1.01325d0
        s_reac = reactants%calc_entropy(weights, 3000.0d0, p_reac)/R

        call solver%solve(solution, 'sp', s_reac, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution, check_closure_defect=.true.)

        do i = 1, totals%m
            @assertLessThan(maxval(abs(totals%delta_check(:, i))), tol)
        end do

    end subroutine


    @test
    subroutine test_sp_derivatives_fd
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: s_reac, p_reac, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        ! integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        p_reac = 1.01325d0
        s_reac = reactants%calc_entropy(weights, 3000.0d0, p_reac)/R

        call solver%solve(solution, 'sp', s_reac, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_constrained_entropy_output_row(totals, 1.0d-4, 1.0d-4)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        ! write(*,*) "dT/dstate1: an=", totals%dT_dstate1, " fd=", totals%dT_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        ! write(*,*) "dT/dstate2: an=", totals%dT_dstate2, " fd=", totals%dT_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        ! write(*,*) "dT/dw0: an=", totals%dT_dw0, " fd=", totals%dT_dw0_fd, " rel=", rel
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        ! write(*,*) "dn/dstate1: an=", totals%dn_dstate1, " fd=", totals%dn_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        ! write(*,*) "dn/dstate2: an=", totals%dn_dstate2, " fd=", totals%dn_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        ! write(*,*) "dn/dw0: an=", totals%dn_dw0, " fd=", totals%dn_dw0_fd, " rel=", rel
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        ! write(*,*) "dnj/dstate1: an=", totals%dnj_dstate1, " fd=", totals%dnj_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        ! write(*,*) "dnj/dstate2: an=", totals%dnj_dstate2, " fd=", totals%dnj_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        ! write(*,*) "dnj/dw0: an=", totals%dnj_dw0, " fd=", totals%dnj_dw0_fd, " rel=", rel
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        ! write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        ! write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        ! write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        ! write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        ! write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        ! write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        ! write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        ! write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)
    end subroutine




    @test
    subroutine test_sp_derivatives_fd_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: s_reac, p_reac, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        integer :: i

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        p_reac = 1.01325d0
        s_reac = reactants%calc_entropy(weights, 3000.0d0, p_reac)/R

        call solver%solve(solution, 'sp', s_reac, p_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_constrained_entropy_output_row(totals, 1.0d-4, 1.0d-4)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        write(*,*) "dT/dstate1: an=", totals%dT_dstate1, " fd=", totals%dT_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        write(*,*) "dT/dstate2: an=", totals%dT_dstate2, " fd=", totals%dT_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        write(*,*) "dT/dw0: an=", totals%dT_dw0, " fd=", totals%dT_dw0_fd, " rel=", rel
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        write(*,*) "dn/dstate1: an=", totals%dn_dstate1, " fd=", totals%dn_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        write(*,*) "dn/dstate2: an=", totals%dn_dstate2, " fd=", totals%dn_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        write(*,*) "dn/dw0: an=", totals%dn_dw0, " fd=", totals%dn_dw0_fd, " rel=", rel
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        write(*,*) "dnj/dstate1: an=", totals%dnj_dstate1, " fd=", totals%dnj_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        write(*,*) "dnj/dstate2: an=", totals%dnj_dstate2, " fd=", totals%dnj_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        write(*,*) "dnj/dw0: an=", totals%dnj_dw0, " fd=", totals%dnj_dw0_fd, " rel=", rel
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        if (abs(totals%dT_dstate1) > 1.0d-12 .and. abs(totals%dT_dstate1_fd) > 1.0d-12) then
            write(*,*) "dH/dT: an=", totals%dH_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dH_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd - totals%dH_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dH_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dU/dT: an=", totals%dU_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dU_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd - totals%dU_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dU_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dG/dT: an=", totals%dG_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dG_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd - totals%dG_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dG_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dS/dT: an=", totals%dS_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dS_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd - totals%dS_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dS_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dCp_fr/dT: an=", totals%dCp_fr_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd - totals%dCp_fr_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dCp_fr_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
        end if

    end subroutine

    @test
    subroutine test_tv_derivatives
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: v_reac, of_ratio, weights(2)
        real(dp), parameter :: tol = 1.0d-6
        integer :: i

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        ! Get the constraint values
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")

        call solver%solve(solution, 'tv', 3000.0d0, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution, check_closure_defect=.true.)

        do i = 1, totals%m
            @assertLessThan(maxval(abs(totals%delta_check(:, i))), tol)
        end do

    end subroutine


    @test
    subroutine test_tv_derivatives_fd
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: v_reac, of_ratio, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 3.0d14
        real(dp) :: rel
        ! integer :: i

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        ! Get the constraint values
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")

        call solver%solve(solution, 'tv', 3000.0d0, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_fixed_temperature_output_row(totals)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        ! write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        ! write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        ! write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        ! write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        ! write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        ! write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        ! write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        ! write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)
    end subroutine




    @test
    subroutine test_tv_derivatives_fd_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: v_reac, of_ratio, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 3.0d14
        real(dp) :: rel
        integer :: i

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the species weights
        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        ! Get the constraint values
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")

        call solver%solve(solution, 'tv', 3000.0d0, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)
        call assert_fixed_temperature_output_row(totals)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / max(abs(totals%dn_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / max(abs(totals%dn_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / max(abs(totals%dn_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        if (abs(totals%dT_dstate1) > 1.0d-12 .and. abs(totals%dT_dstate1_fd) > 1.0d-12) then
            write(*,*) "dH/dT: an=", totals%dH_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dH_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd - totals%dH_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dH_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dU/dT: an=", totals%dU_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dU_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd - totals%dU_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dU_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dG/dT: an=", totals%dG_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dG_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd - totals%dG_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dG_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dS/dT: an=", totals%dS_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dS_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd - totals%dS_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dS_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dCp_fr/dT: an=", totals%dCp_fr_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd - totals%dCp_fr_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dCp_fr_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
        end if

    end subroutine

    @test
    subroutine test_uv_derivatives
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(Mixture) :: reactants, products
        type(EqDerivatives) :: totals
        real(dp) :: v_reac, u_reac, weights(3)
        real(dp), parameter :: tol = 1.0d-6
        integer :: i

        reactants = Mixture(all_thermo, ['Air            ', 'C7H8(L)        ', 'C8H18(L),n-octa'])
        products = Mixture(all_thermo, [character(15) :: &
            '(HCOOH)2',        'Ar',              'C',               'C2',              'CH', &
            'CN',              'CO',              'CO2',             'H',               'H2', &
            'N',               'N2',              'NH',              'NO',              'O',  &
            'O2',              'OH',              'C10H8,naphthale', 'C2H',             'C2H2,acetylene', &
            'C2H2,vinylidene', 'C2H3,vinyl',      'C2H4',            'C2H4O,ethylen-o', 'C2H5', &
            'C2H5OH',          'C2H6',            'C3H3,1-propynl',  'C3H3,2-propynl',  'C3H6O,acetone', &
            'C3H6O,propanal',  'C3H6O,propylox',  'C4H2,butadiyne',  'C4H6,1butyne',    'C4H6,2butyne', &
            'C6H14,n-hexane',  'C7H16,2-methylh', 'CH2',             'CH2CO,ketene',    'CH2OH', &
            'CH3',             'CH3CHO,ethanal',  'CH3CN',           'CH3CO,acetyl',    'CH3COOH', &
            'CH3N2CH3',        'CH3O',            'CH3O2CH3',        'CH3OCH3',         'CH3OH', &
            'CH3OOH',          'CH4',             'CNCOCN',          'CNN',             'COOH', &
            'H2O',             'H2O2',            'HCCN',            'HCCO',            'HCHO,formaldehy', &
            'HCN',             'HCO',             'HCOOH',           'HNC',             'HNCO', &
            'HNO',             'HNO2',            'HNO3',            'HO(CO)2OH',       'HO2', &
            'N2H2',            'N2H4',            'N2O',             'N2O3',            'N2O4', &
            'N2O5',            'N3',              'N3H',             'NCN',             'NCO', &
            'NH2',             'NH2NO2',          'NH2OH',           'NH3',             'NO2', &
            'NO3',             'O(CH)2O',         'O3',              'OCCN',            'OHCH2COOH', &
            'C(gr)',           'H2O(cr)'  &
        ])

        solver = EqSolver(products, reactants, 1d-15)
        solution = EqSolution(solver)

        ! Get the reactant weights
        weights = reactants%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.4d0, 0.6d0], 17.0d0)
        v_reac = 1.0d0/14.428d0
        u_reac = -45.1343d0

        ! Test the full solve
        call solver%solve(solution, 'uv', u_reac, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution, check_closure_defect=.true.)

        do i = 1, totals%m
            @assertLessThan(maxval(abs(totals%delta_check(:, i))), tol)
        end do

    end subroutine


    @test
    subroutine test_uv_derivatives_fd
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(Mixture) :: reactants, products
        type(EqDerivatives) :: totals
        real(dp) :: v_reac, u_reac, weights(3)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        ! integer :: i

        reactants = Mixture(all_thermo, ['Air            ', 'C7H8(L)        ', 'C8H18(L),n-octa'])
        products = Mixture(all_thermo, [character(15) :: &
            '(HCOOH)2',        'Ar',              'C',               'C2',              'CH', &
            'CN',              'CO',              'CO2',             'H',               'H2', &
            'N',               'N2',              'NH',              'NO',              'O',  &
            'O2',              'OH',              'C10H8,naphthale', 'C2H',             'C2H2,acetylene', &
            'C2H2,vinylidene', 'C2H3,vinyl',      'C2H4',            'C2H4O,ethylen-o', 'C2H5', &
            'C2H5OH',          'C2H6',            'C3H3,1-propynl',  'C3H3,2-propynl',  'C3H6O,acetone', &
            'C3H6O,propanal',  'C3H6O,propylox',  'C4H2,butadiyne',  'C4H6,1butyne',    'C4H6,2butyne', &
            'C6H14,n-hexane',  'C7H16,2-methylh', 'CH2',             'CH2CO,ketene',    'CH2OH', &
            'CH3',             'CH3CHO,ethanal',  'CH3CN',           'CH3CO,acetyl',    'CH3COOH', &
            'CH3N2CH3',        'CH3O',            'CH3O2CH3',        'CH3OCH3',         'CH3OH', &
            'CH3OOH',          'CH4',             'CNCOCN',          'CNN',             'COOH', &
            'H2O',             'H2O2',            'HCCN',            'HCCO',            'HCHO,formaldehy', &
            'HCN',             'HCO',             'HCOOH',           'HNC',             'HNCO', &
            'HNO',             'HNO2',            'HNO3',            'HO(CO)2OH',       'HO2', &
            'N2H2',            'N2H4',            'N2O',             'N2O3',            'N2O4', &
            'N2O5',            'N3',              'N3H',             'NCN',             'NCO', &
            'NH2',             'NH2NO2',          'NH2OH',           'NH3',             'NO2', &
            'NO3',             'O(CH)2O',         'O3',              'OCCN',            'OHCH2COOH', &
            'C(gr)',           'H2O(cr)'  &
        ])

        solver = EqSolver(products, reactants, 1d-15)
        solution = EqSolution(solver)

        ! Get the reactant weights
        weights = reactants%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.4d0, 0.6d0], 17.0d0)
        v_reac = 1.0d0/14.428d0
        u_reac = -45.1343d0

        call solver%solve(solution, 'uv', u_reac, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        ! write(*,*) "dT/dstate1: an=", totals%dT_dstate1, " fd=", totals%dT_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        ! write(*,*) "dT/dstate2: an=", totals%dT_dstate2, " fd=", totals%dT_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        ! write(*,*) "dT/dw0: "
        ! do i = 1, solver%num_reactants
            ! write(*,*) "  w0(", i, "): an=", totals%dT_dw0(i), " fd=", totals%dT_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / &
              max(max(abs(totals%dn_dstate1_fd), abs(totals%dn_dstate1)), 1.0d-8)
        ! write(*,*) "dn/dstate1: an=", totals%dn_dstate1, " fd=", totals%dn_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / &
              max(max(abs(totals%dn_dstate2_fd), abs(totals%dn_dstate2)), 1.0d-8)
        ! write(*,*) "dn/dstate2: an=", totals%dn_dstate2, " fd=", totals%dn_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / &
                     max(max(abs(totals%dn_dw0_fd), abs(totals%dn_dw0)), 1.0d-8))
        ! write(*,*) "dn/dw0: "
        ! do i = 1, solver%num_reactants
            ! write(*,*) "  w0(", i, "): an=", totals%dn_dw0(i), " fd=", totals%dn_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        ! write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        ! write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        ! write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        ! write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        ! write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        ! write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        ! write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        ! write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)
    end subroutine




    @test
    subroutine test_uv_derivatives_fd_smooth_truncation
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(Mixture) :: reactants, products
        type(EqDerivatives) :: totals
        real(dp) :: v_reac, u_reac, weights(3)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        integer :: i

        reactants = Mixture(all_thermo, ['Air            ', 'C7H8(L)        ', 'C8H18(L),n-octa'])
        products = Mixture(all_thermo, [character(15) :: &
            '(HCOOH)2',        'Ar',              'C',               'C2',              'CH', &
            'CN',              'CO',              'CO2',             'H',               'H2', &
            'N',               'N2',              'NH',              'NO',              'O',  &
            'O2',              'OH',              'C10H8,naphthale', 'C2H',             'C2H2,acetylene', &
            'C2H2,vinylidene', 'C2H3,vinyl',      'C2H4',            'C2H4O,ethylen-o', 'C2H5', &
            'C2H5OH',          'C2H6',            'C3H3,1-propynl',  'C3H3,2-propynl',  'C3H6O,acetone', &
            'C3H6O,propanal',  'C3H6O,propylox',  'C4H2,butadiyne',  'C4H6,1butyne',    'C4H6,2butyne', &
            'C6H14,n-hexane',  'C7H16,2-methylh', 'CH2',             'CH2CO,ketene',    'CH2OH', &
            'CH3',             'CH3CHO,ethanal',  'CH3CN',           'CH3CO,acetyl',    'CH3COOH', &
            'CH3N2CH3',        'CH3O',            'CH3O2CH3',        'CH3OCH3',         'CH3OH', &
            'CH3OOH',          'CH4',             'CNCOCN',          'CNN',             'COOH', &
            'H2O',             'H2O2',            'HCCN',            'HCCO',            'HCHO,formaldehy', &
            'HCN',             'HCO',             'HCOOH',           'HNC',             'HNCO', &
            'HNO',             'HNO2',            'HNO3',            'HO(CO)2OH',       'HO2', &
            'N2H2',            'N2H4',            'N2O',             'N2O3',            'N2O4', &
            'N2O5',            'N3',              'N3H',             'NCN',             'NCO', &
            'NH2',             'NH2NO2',          'NH2OH',           'NH3',             'NO2', &
            'NO3',             'O(CH)2O',         'O3',              'OCCN',            'OHCH2COOH', &
            'C(gr)',           'H2O(cr)'  &
        ])

        solver = EqSolver(products, reactants, 1d-15, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the reactant weights
        weights = reactants%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.4d0, 0.6d0], 17.0d0)
        v_reac = 1.0d0/14.428d0
        u_reac = -45.1343d0

        call solver%solve(solution, 'uv', u_reac, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        write(*,*) "dT/dstate1: an=", totals%dT_dstate1, " fd=", totals%dT_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        write(*,*) "dT/dstate2: an=", totals%dT_dstate2, " fd=", totals%dT_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        write(*,*) "dT/dw0: "
        do i = 1, solver%num_reactants
            write(*,*) "  w0(", i, "): an=", totals%dT_dw0(i), " fd=", totals%dT_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / &
              max(max(abs(totals%dn_dstate1_fd), abs(totals%dn_dstate1)), 1.0d-8)
        write(*,*) "dn/dstate1: an=", totals%dn_dstate1, " fd=", totals%dn_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / &
              max(max(abs(totals%dn_dstate2_fd), abs(totals%dn_dstate2)), 1.0d-8)
        write(*,*) "dn/dstate2: an=", totals%dn_dstate2, " fd=", totals%dn_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / &
                     max(max(abs(totals%dn_dw0_fd), abs(totals%dn_dw0)), 1.0d-8))
        write(*,*) "dn/dw0: "
        do i = 1, solver%num_reactants
            write(*,*) "  w0(", i, "): an=", totals%dn_dw0(i), " fd=", totals%dn_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / &
                     max(max(abs(totals%dnj_dstate1_fd), abs(totals%dnj_dstate1)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / &
                     max(max(abs(totals%dnj_dstate2_fd), abs(totals%dnj_dstate2)), 1.0d-8))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / &
                     max(max(abs(totals%dnj_dw0_fd), abs(totals%dnj_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        if (abs(totals%dT_dstate1) > 1.0d-12 .and. abs(totals%dT_dstate1_fd) > 1.0d-12) then
            write(*,*) "dH/dT: an=", totals%dH_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dH_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd - totals%dH_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dH_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dU/dT: an=", totals%dU_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dU_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd - totals%dU_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dU_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dG/dT: an=", totals%dG_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dG_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd - totals%dG_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dG_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dS/dT: an=", totals%dS_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dS_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd - totals%dS_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dS_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dCp_fr/dT: an=", totals%dCp_fr_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd - totals%dCp_fr_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dCp_fr_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
        end if

    end subroutine

    @test
    subroutine test_sv_derivatives
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: s_reac, v_reac, of_ratio, weights(2)
        real(dp), parameter :: tol = 1.0d-6
        integer :: i

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        ! Get the constraint values
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")
        s_reac = reactants%calc_entropy(weights, 3000.0d0, 1.01325d0)/R

        call solver%solve(solution, 'sv', s_reac, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution, check_closure_defect=.true.)

        do i = 1, totals%m
            @assertLessThan(maxval(abs(totals%delta_check(:, i))), tol)
        end do

    end subroutine


    @test
    subroutine test_sv_derivatives_fd
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: s_reac, v_reac, of_ratio, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        ! integer :: i

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants)
        solution = EqSolution(solver)

        ! Get the species weights
        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        ! Get the constraint values
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")
        s_reac = reactants%calc_entropy(weights, 3000.0d0, 1.01325d0)/R

        call solver%solve(solution, 'sv', s_reac, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / &
              max(max(abs(totals%dn_dstate1_fd), abs(totals%dn_dstate1)), 1.0d-8)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / &
              max(max(abs(totals%dn_dstate2_fd), abs(totals%dn_dstate2)), 1.0d-8)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / &
                     max(max(abs(totals%dn_dw0_fd), abs(totals%dn_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / max(abs(totals%dnj_dstate1), 1.0d-30))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / max(abs(totals%dnj_dstate2), 1.0d-30))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / max(abs(totals%dnj_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        ! write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        ! write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        ! write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        ! write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        ! write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        ! write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        ! write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        ! write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        ! write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        ! do i = 1, solver%num_reactants
            ! write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        ! end do
        @assertLessThan(rel, tol)
    end subroutine




    @test
    subroutine test_sv_derivatives_fd_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        type(EqDerivatives) :: totals
        real(dp) :: s_reac, v_reac, of_ratio, weights(2)
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol = 1.0d30
        real(dp) :: rel
        integer :: i

        reactants = Mixture(all_thermo, ['H2 ', 'Air'])
        products = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the species weights
        of_ratio = reactants%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        ! Get the constraint values
        v_reac = convert_units_to_si(1.0d0/9.1864d-05, "cm**3/g")
        s_reac = reactants%calc_entropy(weights, 3000.0d0, 1.01325d0)/R

        call solver%solve(solution, 'sv', s_reac, v_reac, weights)

        totals = EqDerivatives(solver, solution)
        call totals%compute_derivatives(solver, solution)
        call totals%unpack_values(solver, solution)
        call totals%compute_fd(solver, solution, h, verbose=.false.)

        rel = abs(totals%dT_dstate1_fd - totals%dT_dstate1) / max(abs(totals%dT_dstate1), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = abs(totals%dT_dstate2_fd - totals%dT_dstate2) / max(abs(totals%dT_dstate2), 1.0d-30)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dT_dw0_fd - totals%dT_dw0) / max(abs(totals%dT_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dn_dstate1_fd - totals%dn_dstate1) / &
              max(max(abs(totals%dn_dstate1_fd), abs(totals%dn_dstate1)), 1.0d-8)
        @assertLessThan(rel, tol)
        rel = abs(totals%dn_dstate2_fd - totals%dn_dstate2) / &
              max(max(abs(totals%dn_dstate2_fd), abs(totals%dn_dstate2)), 1.0d-8)
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dn_dw0_fd - totals%dn_dw0) / &
                     max(max(abs(totals%dn_dw0_fd), abs(totals%dn_dw0)), 1.0d-8))
        @assertLessThan(rel, tol)

        rel = maxval(abs(totals%dnj_dstate1_fd - totals%dnj_dstate1) / max(abs(totals%dnj_dstate1), 1.0d-30))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dstate2_fd - totals%dnj_dstate2) / max(abs(totals%dnj_dstate2), 1.0d-30))
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dnj_dw0_fd - totals%dnj_dw0) / max(abs(totals%dnj_dw0), 1.0d-30))
        @assertLessThan(rel, tol)

        rel = abs(totals%dH_dstate1_fd - totals%dH_dstate1) / max(abs(totals%dH_dstate1), 1.0d-30)
        write(*,*) "dH/dstate1: an=", totals%dH_dstate1, " fd=", totals%dH_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dH_dstate2_fd - totals%dH_dstate2) / max(abs(totals%dH_dstate2), 1.0d-30)
        write(*,*) "dH/dstate2: an=", totals%dH_dstate2, " fd=", totals%dH_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dH_dw0_fd - totals%dH_dw0) / max(abs(totals%dH_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dH/dw0(", i, "): an=", totals%dH_dw0(i), " fd=", totals%dH_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dU_dstate1_fd - totals%dU_dstate1) / max(abs(totals%dU_dstate1), 1.0d-30)
        write(*,*) "dU/dstate1: an=", totals%dU_dstate1, " fd=", totals%dU_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dU_dstate2_fd - totals%dU_dstate2) / max(abs(totals%dU_dstate2), 1.0d-30)
        write(*,*) "dU/dstate2: an=", totals%dU_dstate2, " fd=", totals%dU_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dU_dw0_fd - totals%dU_dw0) / max(abs(totals%dU_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dU/dw0(", i, "): an=", totals%dU_dw0(i), " fd=", totals%dU_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dG_dstate1_fd - totals%dG_dstate1) / max(abs(totals%dG_dstate1), 1.0d-30)
        write(*,*) "dG/dstate1: an=", totals%dG_dstate1, " fd=", totals%dG_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dG_dstate2_fd - totals%dG_dstate2) / max(abs(totals%dG_dstate2), 1.0d-30)
        write(*,*) "dG/dstate2: an=", totals%dG_dstate2, " fd=", totals%dG_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dG_dw0_fd - totals%dG_dw0) / max(abs(totals%dG_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dG/dw0(", i, "): an=", totals%dG_dw0(i), " fd=", totals%dG_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dS_dstate1_fd - totals%dS_dstate1) / max(abs(totals%dS_dstate1), 1.0d-30)
        write(*,*) "dS/dstate1: an=", totals%dS_dstate1, " fd=", totals%dS_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dS_dstate2_fd - totals%dS_dstate2) / max(abs(totals%dS_dstate2), 1.0d-30)
        write(*,*) "dS/dstate2: an=", totals%dS_dstate2, " fd=", totals%dS_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dS_dw0_fd - totals%dS_dw0) / max(abs(totals%dS_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dS/dw0(", i, "): an=", totals%dS_dw0(i), " fd=", totals%dS_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        rel = abs(totals%dCp_fr_dstate1_fd - totals%dCp_fr_dstate1) / max(abs(totals%dCp_fr_dstate1), 1.0d-30)
        write(*,*) "dCp_fr/dstate1: an=", totals%dCp_fr_dstate1, " fd=", totals%dCp_fr_dstate1_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = abs(totals%dCp_fr_dstate2_fd - totals%dCp_fr_dstate2) / max(abs(totals%dCp_fr_dstate2), 1.0d-30)
        write(*,*) "dCp_fr/dstate2: an=", totals%dCp_fr_dstate2, " fd=", totals%dCp_fr_dstate2_fd, " rel=", rel
        @assertLessThan(rel, tol)
        rel = maxval(abs(totals%dCp_fr_dw0_fd - totals%dCp_fr_dw0) / max(abs(totals%dCp_fr_dw0), 1.0d-30))
        do i = 1, solver%num_reactants
            write(*,*) "dCp_fr/dw0(", i, "): an=", totals%dCp_fr_dw0(i), " fd=", totals%dCp_fr_dw0_fd(i)
        end do
        @assertLessThan(rel, tol)

        if (abs(totals%dT_dstate1) > 1.0d-12 .and. abs(totals%dT_dstate1_fd) > 1.0d-12) then
            write(*,*) "dH/dT: an=", totals%dH_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dH_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd - totals%dH_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dH_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dH_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dU/dT: an=", totals%dU_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dU_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd - totals%dU_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dU_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dU_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dG/dT: an=", totals%dG_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dG_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd - totals%dG_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dG_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dG_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dS/dT: an=", totals%dS_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dS_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd - totals%dS_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dS_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dS_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
            write(*,*) "dCp_fr/dT: an=", totals%dCp_fr_dstate1/totals%dT_dstate1, &
                       " fd=", totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd
            rel = abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd - totals%dCp_fr_dstate1/totals%dT_dstate1) / &
                  max(max(abs(totals%dCp_fr_dstate1_fd/totals%dT_dstate1_fd), &
                          abs(totals%dCp_fr_dstate1/totals%dT_dstate1)), 1.0d-30)
            @assertLessThan(rel, tol)
        end if

    end subroutine

    @test
    subroutine test_h2_o2_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        real(dp) :: h_reac, p_reac, weights(2)
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products  = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        @assertEqual(2, solver%num_reactants)
        @assertEqual(6, solver%num_products)
        @assertEqual(2, solver%num_elements)
        @assertEqual(6, solver%num_gas)
        @assertEqual(0, solver%num_condensed)
        @assertEqual(4, solver%max_equations)

        solution = EqSolution(solver)
        @assertEqual(3800.0d0, solution%T)
        @assertEqual(0.1d0/6, solution%nj(3))
        @assertEqual(6, solution%thermo%num_species)
        @assertEqual([4,5], shape(solution%G))
        @assertEqual('  ', solution%constraints%type)
        @assertFalse(any(solution%is_active))

        ! Get the species weights
        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)

        ! Get the constraint values
        h_reac = reactants%calc_enthalpy(weights, 2000.0d0)/R
        p_reac = 1.01325d0

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        @assertTrue(solution%converged)
        @assertRelativelyEqual(3181.2589964650856d0,  solution%T, tol)
        @assertRelativelyEqual(0.06590368364478945d0, solution%mole_fractions(1), tol)
        @assertRelativelyEqual(0.06152807617606959d0, solution%mole_fractions(2), tol)
        @assertRelativelyEqual(0.37638785326991414d0, solution%mole_fractions(3), tol)
        @assertRelativelyEqual(0.09771754800744899d0, solution%mole_fractions(4), tol)
        @assertRelativelyEqual(0.23381507062970186d0, solution%mole_fractions(5), tol)
        @assertRelativelyEqual(0.16464776827208294d0, solution%mole_fractions(6), tol)

    end subroutine

    @test
    subroutine test_h2_air_smooth_truncation
        type(Mixture) :: reac, prod
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        real(dp) :: weights(2), of_ratio, b_reac(5)
        real(dp), parameter :: tol = 1.0d-6

        reac = Mixture(all_thermo, ['H2 ', 'Air'])
        prod = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(prod, reac, smooth_truncation=.true.)
        solution = EqSolution(solver)

        ! Get the oxidant to fuel ratio
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        @assertRelativelyEqual(34.296226d0, of_ratio, tol)
        weights = reac%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], of_ratio)

        b_reac = reac%element_amounts_from_weights(weights)
        solution%constraints = EqConstraints('tp', 3000.0d0, 1.01325d0, b_reac)

        ! Fix the temperature and update the thermo properties
        solution%T = 3000.0d0
        call solver%products%calc_thermo(solution%thermo, solution%T)

        call solver%solve(solution, 'tp', 3000.0d0, 1.01325d0, weights)

        ! Check the solution
        @assertTrue(solution%converged)
        @assertRelativelyEqual(3000.0d0, solution%T, tol)
        @assertRelativelyEqual(3.1415977104767563d-4, solution%nj(1), tol)
        call assert_element_relative_convergence(solver, solution)
        @assertRelativelyEqual(7.5557676949601852d-6, solution%nj(3), tol)
        @assertRelativelyEqual(3.1454568179412088d-6, solution%nj(4), tol)

    end subroutine

    @test
    subroutine test_tp_co_dnj_dp_smooth_threshold_chain_rule
        type(Mixture) :: reac, prod
        type(EqSolver) :: solver_hard, solver_smooth
        type(EqSolution) :: sol_hard, sol_hard_plus, sol_hard_minus
        type(EqSolution) :: sol_smooth, sol_smooth_plus, sol_smooth_minus
        type(EqDerivatives) :: totals_hard, totals_smooth
        real(dp) :: weights(2), fuel_weights(2), oxidizer_weights(2), of_ratio
        real(dp) :: temperature, pressure, h_pressure
        real(dp) :: dnj_dp_hard_fd, dnj_dp_smooth_fd
        real(dp) :: dH_dp_hard_fd, dH_dp_smooth_fd
        real(dp) :: dS_dp_hard_fd, dS_dp_smooth_fd
        real(dp) :: rel_hard, rel_smooth
        real(dp) :: closure_tol
        integer, parameter :: idx_co = 3
        integer, parameter :: idx_h2o = 7
        real(dp), parameter :: tol = 1.0d-2

        reac = Mixture(all_thermo, ['H2 ', 'Air'])
        prod = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver_hard = EqSolver(prod, reac, smooth_truncation=.false.)
        solver_smooth = EqSolver(prod, reac, smooth_truncation=.true.)
        sol_hard = EqSolution(solver_hard)
        sol_hard_plus = EqSolution(solver_hard)
        sol_hard_minus = EqSolution(solver_hard)
        sol_smooth = EqSolution(solver_smooth)
        sol_smooth_plus = EqSolution(solver_smooth)
        sol_smooth_minus = EqSolution(solver_smooth)

        temperature = 1200.0d0
        pressure = 1.01325d0
        h_pressure = pressure*1.0d-4

        fuel_weights = reac%weights_from_moles([1.0d0, 0.0d0])
        oxidizer_weights = reac%weights_from_moles([0.0d0, 1.0d0])
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reac%weights_from_of(oxidizer_weights, fuel_weights, of_ratio)

        call solver_hard%solve(sol_hard, 'tp', temperature, pressure, weights)
        call solver_hard%solve(sol_hard_plus, 'tp', temperature, pressure + h_pressure, weights)
        call solver_hard%solve(sol_hard_minus, 'tp', temperature, pressure - h_pressure, weights)

        totals_hard = EqDerivatives(solver_hard, sol_hard)
        call totals_hard%compute_derivatives(solver_hard, sol_hard)
        call totals_hard%unpack_values(solver_hard, sol_hard)
        dnj_dp_hard_fd = (sol_hard_plus%nj(idx_h2o) - sol_hard_minus%nj(idx_h2o)) / (2.0d0*h_pressure)
        dH_dp_hard_fd = (sol_hard_plus%enthalpy - sol_hard_minus%enthalpy) / (2.0d0*h_pressure)
        dS_dp_hard_fd = (sol_hard_plus%entropy - sol_hard_minus%entropy) / (2.0d0*h_pressure)
        rel_hard = abs(dnj_dp_hard_fd - totals_hard%dnj_dstate2(idx_h2o)) / &
                   max(max(abs(dnj_dp_hard_fd), abs(totals_hard%dnj_dstate2(idx_h2o))), 1.0d-30)
        @assertLessThan(rel_hard, tol)
        rel_hard = abs(dH_dp_hard_fd - totals_hard%dH_dstate2) / &
                   max(max(abs(dH_dp_hard_fd), abs(totals_hard%dH_dstate2)), 1.0d-30)
        @assertLessThan(rel_hard, tol)
        rel_hard = abs(dS_dp_hard_fd - totals_hard%dS_dstate2) / &
                   max(max(abs(dS_dp_hard_fd), abs(totals_hard%dS_dstate2)), 1.0d-30)
        @assertLessThan(rel_hard, tol)

        call solver_smooth%solve(sol_smooth, 'tp', temperature, pressure, weights)
        call solver_smooth%solve(sol_smooth_plus, 'tp', temperature, pressure + h_pressure, weights)
        call solver_smooth%solve(sol_smooth_minus, 'tp', temperature, pressure - h_pressure, weights)

        totals_smooth = EqDerivatives(solver_smooth, sol_smooth)
        call totals_smooth%compute_derivatives(solver_smooth, sol_smooth, check_closure_defect=.true.)
        call totals_smooth%unpack_values(solver_smooth, sol_smooth)
        dnj_dp_smooth_fd = (sol_smooth_plus%nj(idx_h2o) - sol_smooth_minus%nj(idx_h2o)) / (2.0d0*h_pressure)
        dH_dp_smooth_fd = (sol_smooth_plus%enthalpy - sol_smooth_minus%enthalpy) / (2.0d0*h_pressure)
        dS_dp_smooth_fd = (sol_smooth_plus%entropy - sol_smooth_minus%entropy) / (2.0d0*h_pressure)
        rel_smooth = abs(dnj_dp_smooth_fd - totals_smooth%dnj_dstate2(idx_h2o)) / &
                     max(max(abs(dnj_dp_smooth_fd), abs(totals_smooth%dnj_dstate2(idx_h2o))), 1.0d-30)
        @assertLessThan(rel_smooth, tol)
        @assertTrue(abs(totals_smooth%dnj_dstate2(idx_co) - totals_hard%dnj_dstate2(idx_co)) > 1.0d-12)
        rel_smooth = abs(dH_dp_smooth_fd - totals_smooth%dH_dstate2) / &
                     max(max(abs(dH_dp_smooth_fd), abs(totals_smooth%dH_dstate2)), 1.0d-30)
        @assertLessThan(rel_smooth, tol)
        rel_smooth = abs(dS_dp_smooth_fd - totals_smooth%dS_dstate2) / &
                     max(max(abs(dS_dp_smooth_fd), abs(totals_smooth%dS_dstate2)), 1.0d-30)
        @assertLessThan(rel_smooth, tol)

        closure_tol = 1.0d-10
        @assertLessThan(maxval(abs(totals_smooth%delta_check)), closure_tol)
    end subroutine

    @test
    subroutine test_tp_nh2oh_dlnnj_dlnp_smooth_threshold_regression
        type(Mixture) :: reac, prod
        type(EqSolver) :: solver_hard, solver_smooth
        type(EqSolution) :: sol_hard, sol_hard_plus, sol_hard_minus
        type(EqSolution) :: sol_smooth, sol_smooth_plus, sol_smooth_minus
        type(EqDerivatives) :: totals_hard, totals_smooth
        character(4) :: reactant_names(2)
        real(dp) :: weights(2), fuel_weights(2), oxidizer_weights(2), of_ratio
        real(dp) :: pressure, h_pressure
        real(dp) :: dnj_dp_hard_fd, dnj_dp_smooth_fd
        real(dp) :: dlnnj_dlnp_hard_an, dlnnj_dlnp_hard_fd
        real(dp) :: dlnnj_dlnp_smooth_an, dlnnj_dlnp_smooth_fd
        real(dp) :: rel
        real(dp), parameter :: temperature = 3000.0d0
        real(dp), parameter :: pressures(3) = [0.6309573444801936d0, 1.0d0, 10.0d0]
        real(dp), parameter :: h_rel = 1.0d-6
        real(dp), parameter :: deriv_tol = 2.0d-2
        real(dp), parameter :: log_tol = 2.0d-2
        real(dp), parameter :: min_log_gap = 5.0d-2
        integer :: i, k, idx_nh2oh

        reactant_names = ['H2  ', 'Air ']
        reac = Mixture(all_thermo, reactant_names)
        prod = Mixture(all_thermo, reactant_names=reactant_names)

        idx_nh2oh = 0
        do i = 1, prod%num_species
            if (trim(prod%species_names(i)) == 'NH2OH') then
                idx_nh2oh = i
                exit
            end if
        end do
        @assertTrue(idx_nh2oh > 0)

        solver_hard = EqSolver(prod, reac, smooth_truncation=.false.)
        solver_smooth = EqSolver(prod, reac, smooth_truncation=.true.)
        sol_hard = EqSolution(solver_hard)
        sol_hard_plus = EqSolution(solver_hard)
        sol_hard_minus = EqSolution(solver_hard)
        sol_smooth = EqSolution(solver_smooth)
        sol_smooth_plus = EqSolution(solver_smooth)
        sol_smooth_minus = EqSolution(solver_smooth)

        fuel_weights = reac%weights_from_moles([1.0d0, 0.0d0])
        oxidizer_weights = reac%weights_from_moles([0.0d0, 1.0d0])
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reac%weights_from_of(oxidizer_weights, fuel_weights, of_ratio)

        do k = 1, size(pressures)
            pressure = pressures(k)
            h_pressure = pressure*h_rel

            call solver_hard%solve(sol_hard, 'tp', temperature, pressure, weights)
            call solver_hard%solve(sol_hard_plus, 'tp', temperature, pressure + h_pressure, weights)
            call solver_hard%solve(sol_hard_minus, 'tp', temperature, pressure - h_pressure, weights)

            call solver_smooth%solve(sol_smooth, 'tp', temperature, pressure, weights)
            call solver_smooth%solve(sol_smooth_plus, 'tp', temperature, pressure + h_pressure, weights)
            call solver_smooth%solve(sol_smooth_minus, 'tp', temperature, pressure - h_pressure, weights)

            @assertTrue(sol_hard%converged)
            @assertTrue(sol_smooth%converged)
            @assertEqual(solver_smooth%size, sol_smooth%converged_tsize)

            totals_hard = EqDerivatives(solver_hard, sol_hard)
            call totals_hard%compute_derivatives(solver_hard, sol_hard)
            call totals_hard%unpack_values(solver_hard, sol_hard)

            totals_smooth = EqDerivatives(solver_smooth, sol_smooth)
            call totals_smooth%compute_derivatives(solver_smooth, sol_smooth, check_closure_defect=.true.)
            call totals_smooth%unpack_values(solver_smooth, sol_smooth)

            dnj_dp_hard_fd = (sol_hard_plus%nj(idx_nh2oh) - sol_hard_minus%nj(idx_nh2oh)) / &
                             (2.0d0*h_pressure)
            dnj_dp_smooth_fd = (sol_smooth_plus%nj(idx_nh2oh) - sol_smooth_minus%nj(idx_nh2oh)) / &
                               (2.0d0*h_pressure)

            rel = abs(dnj_dp_hard_fd - totals_hard%dnj_dstate2(idx_nh2oh)) / &
                  max(max(abs(dnj_dp_hard_fd), abs(totals_hard%dnj_dstate2(idx_nh2oh))), 1.0d-30)
            @assertLessThan(rel, deriv_tol)

            rel = abs(dnj_dp_smooth_fd - totals_smooth%dnj_dstate2(idx_nh2oh)) / &
                  max(max(abs(dnj_dp_smooth_fd), abs(totals_smooth%dnj_dstate2(idx_nh2oh))), 1.0d-30)
            @assertLessThan(rel, deriv_tol)

            dlnnj_dlnp_hard_an = pressure*totals_hard%dnj_dstate2(idx_nh2oh) / sol_hard%nj(idx_nh2oh)
            dlnnj_dlnp_hard_fd = pressure*dnj_dp_hard_fd / sol_hard%nj(idx_nh2oh)
            rel = abs(dlnnj_dlnp_hard_fd - dlnnj_dlnp_hard_an) / &
                  max(max(abs(dlnnj_dlnp_hard_fd), abs(dlnnj_dlnp_hard_an)), 1.0d-12)
            @assertLessThan(rel, log_tol)

            dlnnj_dlnp_smooth_an = pressure*totals_smooth%dnj_dstate2(idx_nh2oh) / sol_smooth%nj(idx_nh2oh)
            dlnnj_dlnp_smooth_fd = pressure*dnj_dp_smooth_fd / sol_smooth%nj(idx_nh2oh)
            rel = abs(dlnnj_dlnp_smooth_fd - dlnnj_dlnp_smooth_an) / &
                  max(max(abs(dlnnj_dlnp_smooth_fd), abs(dlnnj_dlnp_smooth_an)), 1.0d-12)
            @assertLessThan(rel, log_tol)

            @assertTrue(abs(dlnnj_dlnp_smooth_an - dlnnj_dlnp_hard_an) > min_log_gap)
        end do
    end subroutine

    @test
    subroutine test_tp_smooth_targeted_derivatives_fd
        type(Mixture) :: reac, prod
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        real(dp) :: weights(2), fuel_weights(2), oxidizer_weights(2), of_ratio
        integer :: idx_species, idx_w0
        real(dp), parameter :: temperature = 1200.0d0
        real(dp), parameter :: pressure = 1.01325d0
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol_species = 3.0d-1
        real(dp), parameter :: tol_scalar = 1.5d-1
        real(dp), parameter :: closure_tol = 1.0d-10

        reac = Mixture(all_thermo, ['H2 ', 'Air'])
        prod = Mixture(all_thermo, [ &
            'Ar  ', 'C   ', 'CO  ', 'CO2 ', 'H   ', &
            'H2  ', 'H2O ', 'HNO ', 'HO2 ', 'HNO2', &
            'HNO3', 'N   ', 'NH  ', 'NO  ', 'N2  ', &
            'N2O3', 'O   ', 'O2  ', 'OH  ', 'O3  '  &
        ])

        solver = EqSolver(prod, reac, smooth_truncation=.true.)
        solution = EqSolution(solver)

        fuel_weights = reac%weights_from_moles([1.0d0, 0.0d0])
        oxidizer_weights = reac%weights_from_moles([0.0d0, 1.0d0])
        of_ratio = reac%of_from_equivalence([0.0d0, 1.0d0], [1.0d0, 0.0d0], 1.0d0)
        weights = reac%weights_from_of(oxidizer_weights, fuel_weights, of_ratio)

        call solver%solve(solution, 'tp', temperature, pressure, weights)
        idx_species = find_smooth_target_species(solver, solution)
        idx_w0 = find_target_w0(solution)
        call assert_smooth_targeted_fd(solver, solution, idx_species, idx_w0, h, tol_species, tol_scalar, closure_tol)
    end subroutine

    @test
    subroutine test_hp_smooth_targeted_derivatives_fd
        type(Mixture) :: reactants, products
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        real(dp) :: weights(2), h_reac, p_reac
        integer :: idx_species, idx_w0
        real(dp), parameter :: h = 1.0d-6
        real(dp), parameter :: tol_species = 4.0d-2
        real(dp), parameter :: tol_scalar = 3.0d-1
        real(dp), parameter :: closure_tol = 1.0d-9

        reactants = Mixture(all_thermo, ['H2', 'O2'])
        products = Mixture(all_thermo, ['H  ', 'H2 ', 'H2O', 'O  ', 'O2 ', 'OH '])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        weights = reactants%weights_from_moles([1.0d0, 1.0d0])
        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 15.87336d0)
        h_reac = reactants%calc_enthalpy(weights, 2000.0d0)/R
        p_reac = 1.01325d0

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)
        idx_species = find_smooth_target_species(solver, solution)
        idx_w0 = find_target_w0(solution)
        call assert_smooth_targeted_fd(solver, solution, idx_species, idx_w0, h, tol_species, tol_scalar, closure_tol)
    end subroutine

