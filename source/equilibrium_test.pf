    @test
    subroutine test_condensed_problem_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        real(dp) :: h_reac, p_reac, weights(2)
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Air    ', 'H2O(cr)'])
        products  = Mixture(all_thermo, ['Ar     ', 'O2     ', 'N2     ', 'CO2    ', 'H2O    ', 'H2O(L) ', 'H2O(cr)'])

        solver = EqSolver(products, reactants, smooth_truncation=.true.)
        solution = EqSolution(solver)

        weights = reactants%weights_from_of([1.0d0, 0.0d0], [0.0d0, 1.0d0], 100.0d0)
        h_reac = reactants%calc_enthalpy(weights, [300.0d0, 225.0d0])/R
        p_reac = 1.0d0

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        @assertTrue(solution%converged)
        @assertRelativelyEqual(280.02206703353028d0,  solution%T, tol)
        @assertRelativelyEqual(-8.0468184810795194d0, solution%ln_nj(1), tol)
        @assertRelativelyEqual(-11.426361993172849d0, solution%ln_nj(4), tol)
        @assertRelativelyEqual(-7.9775192465687397d0, solution%ln_nj(5), tol)
        @assertRelativelyEqual(-3.6234275536806750d0, solution%ln_nj(3), tol)
        @assertRelativelyEqual(-4.9391886426482596d0, solution%ln_nj(2), tol)
        @assertRelativelyEqual(2.0649897863602413d-4, solution%nj(6), tol)

    end subroutine

    @test
    subroutine test_ionized_smooth_truncation

        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: soln
        character(snl), allocatable :: product_names(:)
        real(dp) :: p_reac, t_reac, weights(1)
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Air'], ions=.true.)
        product_names = reactants%get_products(all_thermo, omit=["C(gr)"])
        products = Mixture(all_thermo, product_names, ions=.true.)

        solver = EqSolver(products, reactants, ions=.true., smooth_truncation=.true.)
        soln = EqSolution(solver)

        weights = [1.0d0]
        t_reac = 5000.0d0
        p_reac = 0.0101325d0

        call solver%solve(soln, 'tp', t_reac, p_reac, weights)

        ! Testing products (in order): e-, Ar, Ar+, C, C+, C-, CO, CO+, CO2, CO2+, N, N+, N-, N2, N2+, N2-, O2, O2+, O2-
        @assertTrue(soln%converged)
        @assertRelativelyEqual(5.7267835261230931d-6, soln%nj(55), tol)
        @assertRelativelyEqual(3.2331974188553995d-4, soln%nj(1), tol)
        @assertRelativelyEqual(3.5936041313142031d-7, soln%nj(3), tol)
        @assertRelativelyEqual(1.0633967384370233d-5, soln%nj(23), tol)
        @assertRelativelyEqual(1.0500336341966676d-2, soln%nj(27), tol)
        @assertRelativelyEqual(2.1670128503500238d-2, soln%nj(30), tol)
        @assertRelativelyEqual(9.1264090127626698d-7, soln%nj(50), tol)

    end subroutine

    @test
    subroutine test_equilibrium_transport_ch4_o2_smooth_truncation
        type(Mixture) :: products
        type(Mixture) :: reactants
        type(EqSolver) :: solver
        type(EqSolution) :: solution
        character(:), allocatable :: product_names(:)
        real(dp) :: h_reac, p_reac, weights(2)

        reactants = Mixture(all_thermo, ['CH4', 'O2 '])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants, all_transport=all_transport, smooth_truncation=.true.)
        solution = EqSolution(solver)

        weights = reactants%weights_from_of([0.0d0, 1.0d0], [1.0d0, 0.0d0], 2.6d0)
        h_reac = reactants%calc_enthalpy(weights, [298.15d0, 298.15d0])/R
        p_reac = psi_to_bar(1000.0d0)

        call solver%solve(solution, 'hp', h_reac, p_reac, weights)

        @assertTrue(solution%converged)
        @assertTrue(solution%T > 0.0d0)
    end subroutine

    @test
    subroutine test_issue42_reuse_solution_hp_then_tp
        type(Mixture) :: reactants
        type(Mixture) :: products
        type(EqSolver) :: solver
        type(EqSolution) :: reuse_soln, fresh_soln
        character(:), allocatable :: product_names(:)
        real(dp) :: weights(2), of_ratio
        real(dp) :: h1, p1, p2, t2
        real(dp) :: max_nj_diff
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['O2  ', 'C2H4'])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants)
        reuse_soln = EqSolution(solver)
        fresh_soln = EqSolution(solver)

        of_ratio = reactants%of_from_equivalence([1.0d0, 0.0d0], [0.0d0, 1.0d0], 0.4d0)
        weights = reactants%weights_from_of([1.0d0, 0.0d0], [0.0d0, 1.0d0], of_ratio)

        h1 = 129.92208593485029d0
        p1 = 60.0d0
        p2 = 95.242559745142628d0
        t2 = 3585.9524742656135d0

        call solver%solve(reuse_soln, 'hp', h1, p1, weights)
        @assertTrue(reuse_soln%converged)
        call solver%solve(reuse_soln, 'tp', t2, p2, weights)
        @assertTrue(reuse_soln%converged)

        call solver%solve(fresh_soln, 'tp', t2, p2, weights)
        @assertTrue(fresh_soln%converged)

        max_nj_diff = maxval(abs(reuse_soln%nj - fresh_soln%nj))
        @assertRelativelyEqual(fresh_soln%T, reuse_soln%T, tol)
        @assertRelativelyEqual(fresh_soln%n, reuse_soln%n, tol)
        @assertTrue(max_nj_diff < 1.0d-8)
    end subroutine

    @test
    subroutine test_issue42_reuse_solution_condensed_tp_grid
        type(Mixture) :: reactants
        type(Mixture) :: products
        type(EqSolver) :: solver
        type(EqSolution) :: reuse_soln, fresh_soln
        character(:), allocatable :: product_names(:)
        integer :: i
        real(dp) :: af_values(6), t_values(6), p_values(6)
        real(dp) :: weights(3), max_nj_diff
        logical :: found_condensed
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Air ', 'C2H4', 'AL  '])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants)
        reuse_soln = EqSolution(solver)

        ! Representative condensed-phase history sequence from Issue #42 reports.
        af_values = [5.0d0, 5.0d0, 15.0d0, 15.0d0, 25.0d0, 25.0d0]
        t_values = [3000.0d0, 3750.0d0, 3000.0d0, 3250.0d0, 3000.0d0, 3750.0d0]
        p_values = [0.1d0, 8.1d0, 0.1d0, 2.1d0, 4.1d0, 8.1d0]
        found_condensed = .false.

        do i = 1, size(af_values)
            weights = reactants%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.5d0, 0.5d0], af_values(i))

            call solver%solve(reuse_soln, 'tp', t_values(i), p_values(i), weights)
            @assertTrue(reuse_soln%converged)
            if (any(reuse_soln%is_active)) found_condensed = .true.

            fresh_soln = EqSolution(solver)
            call solver%solve(fresh_soln, 'tp', t_values(i), p_values(i), weights)
            @assertTrue(fresh_soln%converged)

            max_nj_diff = maxval(abs(reuse_soln%nj - fresh_soln%nj))
            @assertRelativelyEqual(fresh_soln%T, reuse_soln%T, tol)
            @assertRelativelyEqual(fresh_soln%n, reuse_soln%n, tol)
            @assertTrue(max_nj_diff < 1.0d-6)
        end do

        @assertTrue(found_condensed)
    end subroutine

    @test
    subroutine test_reuse_solution_recovers_after_nonconverged_point
        type(Mixture) :: reactants
        type(Mixture) :: products
        type(EqSolver) :: solver
        type(EqSolution) :: reuse_soln, fresh_soln
        character(:), allocatable :: product_names(:)
        real(dp) :: weights(3), h_fail
        real(dp) :: max_nj_diff
        integer :: max_iterations_saved
        real(dp), parameter :: tol = 1.0d-6

        reactants = Mixture(all_thermo, ['Air ', 'C2H4', 'AL  '])
        product_names = reactants%get_products(all_thermo)
        products = Mixture(all_thermo, product_names)

        solver = EqSolver(products, reactants)
        reuse_soln = EqSolution(solver)
        fresh_soln = EqSolution(solver)

        weights = reactants%weights_from_of([1.0d0, 0.0d0, 0.0d0], [0.0d0, 0.5d0, 0.5d0], 20.0d0)

        call solver%solve(reuse_soln, 'tp', 3000.0d0, 1.0d0, weights)
        @assertTrue(reuse_soln%converged)

        max_iterations_saved = solver%max_iterations
        solver%max_iterations = 1
        h_fail = reactants%calc_enthalpy(weights, 1200.0d0) / R
        call solver%solve(reuse_soln, 'hp', h_fail, 0.1d0, weights)
        @assertFalse(reuse_soln%converged)
        solver%max_iterations = max_iterations_saved

        call solver%solve(reuse_soln, 'tp', 3750.0d0, 8.1d0, weights)
        @assertTrue(reuse_soln%converged)

        call solver%solve(fresh_soln, 'tp', 3750.0d0, 8.1d0, weights)
        @assertTrue(fresh_soln%converged)

        max_nj_diff = maxval(abs(reuse_soln%nj - fresh_soln%nj))
        @assertRelativelyEqual(fresh_soln%T, reuse_soln%T, tol)
        @assertRelativelyEqual(fresh_soln%n, reuse_soln%n, tol)
        @assertTrue(max_nj_diff < 1.0d-6)
    end subroutine

end module
